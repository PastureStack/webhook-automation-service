#!/usr/bin/env bash
# PastureStack static, deterministic Go 1.26 build.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
source "${repo_root}/scripts/version"

go_version="$(GO111MODULE=off GOTOOLCHAIN=local go env GOVERSION)"
if [[ ! "${go_version}" =~ ^go1\.26([.]|$) ]]; then
    printf 'Go 1.26 is required; found %s\n' "${go_version}" >&2
    exit 1
fi

mkdir -p "${repo_root}/bin"
(
    cd "${repo_root}"
    GO111MODULE=off GOTOOLCHAIN=local CGO_ENABLED=0 go build \
        -trimpath \
        -buildvcs=false \
        -tags "netgo osusergo" \
        -ldflags "-buildid= -s -w -X main.VERSION=${VERSION}" \
        -o "${repo_root}/bin/webhook-automation-service" .
)
