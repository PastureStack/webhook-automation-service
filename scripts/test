#!/usr/bin/env bash
# PastureStack unit, coverage, and race tests.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "${repo_root}"

go_version="$(GOTOOLCHAIN=local go env GOVERSION)"
if [[ ! "${go_version}" =~ ^go1\.27([.]|$) ]]; then
    printf 'Go 1.27 is required; found %s\n' "${go_version}" >&2
    exit 1
fi

GOTOOLCHAIN=local CGO_ENABLED=0 go test -mod=vendor -count=1 -cover -tags=test ./...
GOTOOLCHAIN=local CGO_ENABLED=1 go test -mod=vendor -count=1 -race -tags=test ./...
