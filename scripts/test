#!/usr/bin/env bash
# PastureStack unit, coverage, and race tests.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "${repo_root}"

go_version="$(GO111MODULE=off GOTOOLCHAIN=local go env GOVERSION)"
if [[ ! "${go_version}" =~ ^go1\.26([.]|$) ]]; then
    printf 'Go 1.26 is required; found %s\n' "${go_version}" >&2
    exit 1
fi

GO111MODULE=off GOTOOLCHAIN=local CGO_ENABLED=0 go test -count=1 -cover -tags=test ./...
GO111MODULE=off GOTOOLCHAIN=local CGO_ENABLED=1 go test -count=1 -race -tags=test ./...
