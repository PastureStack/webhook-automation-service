#!/usr/bin/env bash
# PastureStack formatting, dependency, static-analysis, and public-content gates.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "${repo_root}"

go_version="$(GOTOOLCHAIN=local go env GOVERSION)"
if [[ ! "${go_version}" =~ ^go1\.27([.]|$) ]]; then
    printf 'Go 1.27 is required; found %s\n' "${go_version}" >&2
    exit 1
fi

mapfile -t unformatted < <(find . \
    -path './vendor' -prune -o \
    -path './third_party' -prune -o \
    -path './bin' -prune -o \
    -path './dist' -prune -o \
    -name '*.go' -type f -print | sort | xargs gofmt -l)
if (( ${#unformatted[@]} > 0 )); then
    printf 'Unformatted Go source:\n%s\n' "${unformatted[@]}" >&2
    exit 1
fi

GOTOOLCHAIN=local go mod verify
GOTOOLCHAIN=local go mod tidy -diff
GOTOOLCHAIN=local CGO_ENABLED=0 go vet -mod=vendor ./...
if GOTOOLCHAIN=local go list -mod=vendor -deps ./... | \
    grep -E 'dgrijalva/jwt-go|rancher-auth-service|dchest/uniuri' >/dev/null; then
    printf 'Removed security-sensitive dependency remains in the build graph.\n' >&2
    exit 1
fi

for legal_file in \
    vendor/github.com/gorilla/context/LICENSE \
    vendor/github.com/gorilla/mux/LICENSE \
    vendor/github.com/gorilla/websocket/LICENSE \
    vendor/github.com/go-viper/mapstructure/v2/LICENSE \
    vendor/github.com/rancher/go-rancher/LICENSE \
    vendor/github.com/sirupsen/logrus/LICENSE \
    vendor/github.com/urfave/cli/v3/LICENSE \
    vendor/golang.org/x/sys/LICENSE; do
    test -f "${legal_file}"
done

grep -F 'github.com/go-viper/mapstructure/v2 v2.5.0' vendor/modules.txt >/dev/null
grep -F 'github.com/sirupsen/logrus v1.10.1' vendor/modules.txt >/dev/null
grep -F 'github.com/urfave/cli/v3 v3.11.0' vendor/modules.txt >/dev/null
grep -F 'golang.org/x/sys v0.47.0' vendor/modules.txt >/dev/null
if grep -R -n -E 'GO111MODULE=off|github.com/Sirupsen/logrus|github.com/mitchellh/mapstructure|github.com/urfave/cli"|gopkg.in/check.v1' \
    --exclude=validate --exclude-dir=.git --exclude-dir=bin --exclude-dir=dist --exclude-dir=vendor .; then
    printf 'A retired GOPATH or dependency contract remains.\n' >&2
    exit 1
fi

"${repo_root}/scripts/check-content-policy"
