#!/usr/bin/env bash

version_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
version_repo_root="$(cd "${version_script_dir}/.." && pwd)"

VERSION="${VERSION:-0.10.1}"
COMMIT="${COMMIT:-$(git -c safe.directory="${version_repo_root}" -C "${version_repo_root}" rev-parse HEAD)}"
ARCH="${ARCH:-amd64}"

if [[ ! "${VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'VERSION must be a numeric semantic version; found %s\n' "${VERSION}" >&2
    return 1 2>/dev/null || exit 1
fi

export VERSION COMMIT ARCH
